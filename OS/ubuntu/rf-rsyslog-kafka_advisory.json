{
    "package_name": "rf-rsyslog-kafka",
    "advisory": {
        "20.04": {
            "CVE-2026-92709": {
                "cve_id": "CVE-2026-92709",
                "title": "Rsyslog is a rocket-fast system for log processing. From versions ...",
                "description": "Rsyslog is a rocket-fast system for log processing. From versions 1.15.0 to 8.2610.0, rsyslog's omfile dynaFile facility intentionally allows templates to generate flexible output paths. This supports valid deployments that route logs into different directories or use dynamically generated file names. A deployment becomes unsafe when a dynaFile template uses a value influenced by untrusted input as a path component without explicit secure-path handling. In that configuration, the rendered path can escape the operator's intended log directory. This is not limited to the RFC5424 HOSTNAME field. Any untrusted value that reaches a dynaFile path component can create the condition. At time of publication, there are no publicly available patches.",
                "severity": "MEDIUM",
                "status": "open",
                "events": [
                    {
                        "introduced": "0:8.2312.0-13rfubu",
                        "identifier": "rf"
                    }
                ]
            },
            "CVE-2026-129829": {
                "cve_id": "CVE-2026-129829",
                "title": "The rsyslog's`imuxsock` special parser can end up writing into th ...",
                "description": "The rsyslog's`imuxsock` special parser can end up writing into the received message raw buffer when trying to replace the message timestamp with the system's timestamp. A local attacker with the ability to write to the `imuxsock` socket can leverage that by crafting a malformed PRI value with a short timestamp to lead the rsyslog to perform the out-of-bounds write.",
                "severity": "MEDIUM",
                "status": "open",
                "events": [
                    {
                        "introduced": "0:8.2312.0-13rfubu",
                        "identifier": "rf"
                    }
                ]
            },
            "CVE-2026-129830": {
                "cve_id": "CVE-2026-129830",
                "title": "When the rsyslog's `imuxsock` is parsing the TAG field from a mes ...",
                "description": "When the rsyslog's `imuxsock` is parsing the TAG field from a message with a accepted shorter timestamp, the cursor used to read the message fields and the remaining message length to be read are left in a inconsistent state in relation to the content in the raw message, leading the module to read one byte past the end of the buffer holding the message.",
                "severity": "MEDIUM",
                "status": "open",
                "events": [
                    {
                        "introduced": "0:8.2312.0-13rfubu",
                        "identifier": "rf"
                    }
                ]
            },
