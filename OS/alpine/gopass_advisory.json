    "package_name": "gopass",
    "advisory": {
        "3.20": {
            "CVE-2026-118756": {
                "cve_id": "CVE-2026-118756",
                "title": "gopass before 1.17.0 contains a path traversal vulnerability in t ...",
                "description": "gopass before 1.17.0 contains a path traversal vulnerability in the filesystem storage backend that allows attackers to delete directories outside the password store via ../ entry names in Prune and IsDir. Collaborators with write access to a shared git-synced store can introduce crafted entries, causing a victim's recursive gopass rm -r to delete arbitrary directory trees.",
                "severity": "MEDIUM",
                "status": "fixed",
                "events": [
                    {
                        "introduced": "1.15.13-r3",
                        "fixed": "1.17.0-r0"
                    }
                ]
            },
