{
    "package_name": "quickjs-ng",
    "advisory": {
        "3.20": {
            "CVE-2026-120438": {
                "cve_id": "CVE-2026-120438",
                "title": "QuickJS-NG before 0.16.0 contains an integer overflow in js_proxy ...",
                "description": "QuickJS-NG before 0.16.0 contains an integer overflow in js_proxy_get_own_property_names() in quickjs.c that causes a heap buffer overflow on 32-bit hosts. Attackers running JavaScript can return a large array-like object from a Proxy ownKeys trap to wrap the allocation size, causing crashes or potential code execution.",
                "severity": "HIGH",
                "status": "fixed",
                "events": [
                    {
                        "introduced": "0.11.0-r1",
                        "fixed": "0.16.1-r0"
                    }
                ]
            },
            "CVE-2026-120439": {
                "cve_id": "CVE-2026-120439",
                "title": "QuickJS-NG before 0.16.0 contains an integer overflow in js_typed ...",
                "description": "QuickJS-NG before 0.16.0 contains an integer overflow in js_typed_array_sort() in quickjs.c that allows attackers to cause a heap buffer overflow on 32-bit hosts. Attackers who can run JavaScript can call TypedArray.prototype.sort with a comparator on a typed array near 2^30 elements, wrapping the allocation size and writing indices past the buffer to crash or potentially execute code.",
                "severity": "HIGH",
                "status": "fixed",
                "events": [
                    {
                        "introduced": "0.11.0-r1",
                        "fixed": "0.16.1-r0"
                    }
                ]
            },
            "CVE-2026-120440": {
                "cve_id": "CVE-2026-120440",
                "title": "QuickJS-NG before 0.16.0 contains a memory leak vulnerability in  ...",
                "description": "QuickJS-NG before 0.16.0 contains a memory leak vulnerability in js_atomics_store() in quickjs.c that fails to free the converted value when returning a RangeError. Attackers running JavaScript can repeatedly call Atomics.store with a valueOf that detaches or shrinks the buffer to exhaust heap memory and cause denial of service.",
                "severity": "MEDIUM",
                "status": "fixed",
                "events": [
                    {
                        "introduced": "0.11.0-r1",
                        "fixed": "0.16.1-r0"
                    }
                ]
            },
