{
    "package_name": "keepassxc",
    "advisory": {
        "3.20": {
            "CVE-2026-118673": {
                "cve_id": "CVE-2026-118673",
                "title": "KeePassXC is a cross-platform community-driven port of the Window ...",
                "description": "KeePassXC is a cross-platform community-driven port of the Windows application KeePass Password Safe. From 2.3.0 until 2.8.0, KeePassXC browser integration encrypts authorized responses in src/browser/BrowserMessageBuilder.cpp using a fixed 1 MiB output vector even though Botan::Sodium::crypto_box_easy() writes the plaintext length plus crypto_box_MACBYTES. A browser-protocol client that can access the per-user IPC endpoint, has a valid database association, and causes an unlocked database to generate and encrypt a sufficiently large authorized response can trigger a sequential out-of-bounds write before any response is delivered. This issue is fixed in version 2.8.0.",
                "severity": "MEDIUM",
                "status": "open",
                "events": [
                    {
                        "introduced": "2.7.8-r0"
                    },
                    {
                        "introduced": "2.7.9-r1"
                    },
                    {
                        "introduced": "2.7.10-r0"
                    },
                    {
                        "introduced": "2.7.11-r0"
                    },
                    {
                        "introduced": "2.7.12-r1"
                    }
                ]
            },
            "CVE-2026-4158": {
                "cve_id": "CVE-2026-4158",
                "title": "KeePassXC OpenSSL Configuration Uncontrolled Search Path Element  ...",
                "description": "KeePassXC OpenSSL Configuration Uncontrolled Search Path Element Local Privilege Escalation Vulnerability. This vulnerability allows local attackers to escalate privileges on affected installations of KeePassXC. An attacker must first obtain the ability to execute low-privileged code on the target system in order to exploit this vulnerability.\n\nThe specific flaw exists within the configuration of OpenSSL. The product loads configuration from an unsecured location. An attacker can leverage this vulnerability to escalate privileges and execute arbitrary code in the context of KeePassXC when run by a target user on the system. Was ZDI-CAN-29156.",
                "severity": "HIGH",
                "status": "fixed",
                "events": [
                    {
                        "introduced": "2.7.8-r0",
                        "fixed": "2.7.12-r1"
                    }
                ]
            },
