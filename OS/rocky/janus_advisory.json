        "10": {
            "CVE-2026-110717": {
                "cve_id": "CVE-2026-110717",
                "title": "Janus WebRTC Server through 1.4.3 contains a path traversal vulne ...",
                "description": "Janus WebRTC Server through 1.4.3 contains a path traversal vulnerability in the Record&Play plugin that allows unauthenticated attackers to write files outside recordings_path via the record request filename. Attackers can supply filenames with path separators to create or truncate files ending in -audio.mjr, -video.mjr or -data.mjr anywhere the Janus process can write outside protected folders.",
                "severity": "MEDIUM",
                "status": "fixed",
